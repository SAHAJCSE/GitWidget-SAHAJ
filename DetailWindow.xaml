<Window x:Class="GitHubDesktopWidget.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Activity &amp; Top Repositories"
        Icon="Assets/icon.ico"
        Width="740" Height="500"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="ApplePillBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Apple macOS Dark Card -->
    <Border Background="#121214"
            BorderBrush="#2C2C30"
            BorderThickness="1"
            CornerRadius="24"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Window Header / Title Bar -->
            <Grid Grid.Row="0" Margin="18,12,18,0">
                <!-- macOS Traffic Lights -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button Width="12" Height="12" Click="CloseButton_Click" Cursor="Hand" ToolTip="Close (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="dot" CornerRadius="6" Background="#FF5F56" BorderBrush="#E0443E" BorderThickness="0.5"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="dot" Property="Background" Value="#E0443E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" BorderBrush="#DEA123" BorderThickness="0.5" Margin="7,0,0,0" Opacity="0.6"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#27C93F" BorderBrush="#1AAB29" BorderThickness="0.5" Margin="7,0,0,0" Opacity="0.6"/>
                </StackPanel>

                <!-- Activity Headline -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailTitleText" Text="Loading activity..." FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </StackPanel>

                <!-- User Badge & Close -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock x:Name="UsernameBadge" Text="@username" FontSize="11" Foreground="#39D353" FontFamily="Consolas"/>
                    </Border>
                    <Button Width="22" Height="22" Click="CloseButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="11">
                                    <TextBlock Text="✕" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2C2C30"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <Grid x:Name="LoadingPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Fetching 12-Month GitHub Activity &amp; Repositories..." FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Heatmap View (Full 52 Weeks) -->
            <Grid x:Name="HeatmapContainer" Grid.Row="1" Margin="20,14,20,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Days of Week -->
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="1" Text="Mon" FontSize="8" Foreground="#6A7C70" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Text="Wed" FontSize="8" Foreground="#6A7C70" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Text="Fri" FontSize="8" Foreground="#6A7C70" FontFamily="Consolas" VerticalAlignment="Center"/>
                </Grid>

                <!-- Month Labels -->
                <Grid x:Name="MonthLabelsGrid" Grid.Row="0" Grid.Column="1" Height="16"/>

                <!-- 52-Week Heatmap Grid -->
                <Grid x:Name="FullHeatmapGrid" Grid.Row="1" Grid.Column="1"/>
            </Grid>

            <!-- Bottom Expandable Panel: "Top contributions in:" -->
            <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0" CornerRadius="0,0,24,24" Padding="18,12">
                <StackPanel>
                    <!-- Header Row: Top contributions in: + Stack of Avatars + Expand/Collapse Button -->
                    <Grid Cursor="Hand" MouseLeftButtonDown="ToggleRepos_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Top contributions in:" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TopReposSummary" Text="" FontSize="11" Foreground="#8E8E93" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Avatar Stack for Top Repositories -->
                            <StackPanel x:Name="AvatarStack" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Expand / Collapse Chevron Button -->
                            <Border x:Name="ChevronBorder" Width="26" Height="26" CornerRadius="13" Background="#26262B">
                                <TextBlock x:Name="ChevronText" Text="⌄" FontSize="14" FontWeight="Bold" Foreground="#A1A1A6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Expandable Top Repositories List -->
                    <StackPanel x:Name="ReposListPanel" Margin="0,12,0,0" Visibility="Visible"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
