<Window x:Class="GitHubDesktopWidget.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Activity &amp; Analytics"
        Icon="Assets/icon.ico"
        Width="880" Height="680"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Apple Pill Style for Mood Buttons -->
        <Style x:Key="MoodPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#2C2C32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ApplePillBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Apple macOS Dark Card -->
    <Border Background="#121214"
            BorderBrush="#2C2C30"
            BorderThickness="1"
            CornerRadius="22"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>  <!-- Scrollable Analytics Body -->
            </Grid.RowDefinitions>

            <!-- Window Header / Title Bar -->
            <Grid Grid.Row="0" Margin="18,12,18,0">
                <!-- macOS Traffic Lights -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button Width="12" Height="12" Click="CloseButton_Click" Cursor="Hand" ToolTip="Close (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="dot" CornerRadius="6" Background="#FF5F56" BorderBrush="#E0443E" BorderThickness="0.5"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="dot" Property="Background" Value="#E0443E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" BorderBrush="#DEA123" BorderThickness="0.5" Margin="7,0,0,0" Opacity="0.6"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#27C93F" BorderBrush="#1AAB29" BorderThickness="0.5" Margin="7,0,0,0" Opacity="0.6"/>
                </StackPanel>

                <!-- Activity Headline -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailTitleText" Text="GitHub Activity &amp; Analytics" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </StackPanel>

                <!-- User Badge & Close -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock x:Name="UsernameBadge" Text="@username" FontSize="11" Foreground="#39D353" FontFamily="Consolas"/>
                    </Border>
                    <Button Width="22" Height="22" Click="CloseButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="11">
                                    <TextBlock Text="✕" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2C2C30"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <Grid x:Name="LoadingPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Analyzing GitHub Contributions, Rhythm &amp; Repositories..." FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Main Scrollable Dashboard Content -->
            <ScrollViewer x:Name="DashboardScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,10,20,16" Visibility="Collapsed">
                <StackPanel>
                    <!-- 1. Interactive Big Character Hero Banner -->
                    <Border Background="#18181C" BorderBrush="#26262B" BorderThickness="1" CornerRadius="16" Padding="16,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Big Expressive Character Canvas (58x52) -->
                            <Grid Grid.Column="0" Width="58" Height="52" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand" MouseLeftButtonDown="HeroBot_Click" ToolTip="Click to play mood audio!">
                                <!-- Electric Lightning Bolt Background for Excited -->
                                <Path x:Name="HeroLightning" Data="M 29,3 L 39,19 L 29,22 L 35,37 L 17,22 L 27,19 Z" Fill="#FFD23F" Stretch="Uniform" Width="56" Height="52" Visibility="Collapsed" Opacity="0.9"/>

                                <!-- Big Body -->
                                <Rectangle x:Name="HeroBody" Width="52" Height="46" RadiusX="20" RadiusY="20" Stroke="#45FFFFFF" StrokeThickness="1">
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.4,0.3" RadiusX="0.8" RadiusY="0.8">
                                            <GradientStop x:Name="HeroGrad1" Color="#99E870" Offset="0"/>
                                            <GradientStop x:Name="HeroGrad2" Color="#58B838" Offset="0.6"/>
                                            <GradientStop x:Name="HeroGrad3" Color="#2E6A1C" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Specular Gloss Reflection -->
                                <Ellipse Width="26" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" Opacity="0.8">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.3" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#CCFFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Eyes -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0">
                                    <Path x:Name="HeroLeftEye" Data="M 0,6 Q 6,0 12,6" Stroke="#1E4010" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0"/>
                                    <Path x:Name="HeroRightEye" Data="M 0,6 Q 6,0 12,6" Stroke="#1E4010" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </StackPanel>

                                <!-- Mouth -->
                                <Path x:Name="HeroMouth" Data="M 0,0 Q 8,8 16,0" Stroke="#1E4010" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,31,0,0"/>

                                <!-- Sleepy Mouth -->
                                <Ellipse x:Name="HeroSleepyMouth" Width="8" Height="9" Fill="#102848" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,29,0,0" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Middle: Revealing Text Commentary -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock x:Name="HeroMoodTitle" Text="Mood: Happy 😊" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#2039D353" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeroMoodBadge" Text="Active" FontSize="9.5" FontWeight="Bold" Foreground="#39D353"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="HeroCommentary" Text="Great consistency detected! Your commit activity is looking healthy and vibrant." FontSize="11" Foreground="#A1A1A6" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Right: 6 Interactive Mood Expression Switchers (From Attached Image) -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="SELECT MOOD" FontSize="8.5" FontWeight="Bold" Foreground="#6E6E73" FontFamily="Consolas" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                                <WrapPanel HorizontalAlignment="Right" MaxWidth="240">
                                    <Border Style="{StaticResource MoodPillStyle}" MouseLeftButtonDown="MoodPill_Click" Tag="happy">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#99E870" Margin="0,0,4,0"/>
                                            <TextBlock Text="Happy" FontSize="10" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MoodPillStyle}" MouseLeftButtonDown="MoodPill_Click" Tag="angry">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#FF7E52" Margin="0,0,4,0"/>
                                            <TextBlock Text="Angry" FontSize="10" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MoodPillStyle}" MouseLeftButtonDown="MoodPill_Click" Tag="sleepy">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#89C4FF" Margin="0,0,4,0"/>
                                            <TextBlock Text="Sleepy" FontSize="10" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MoodPillStyle}" MouseLeftButtonDown="MoodPill_Click" Tag="bored" Margin="0,5,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#FFA4C9" Margin="0,0,4,0"/>
                                            <TextBlock Text="Bored" FontSize="10" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MoodPillStyle}" MouseLeftButtonDown="MoodPill_Click" Tag="calm" Margin="0,5,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#C08FFF" Margin="0,0,4,0"/>
                                            <TextBlock Text="Calm" FontSize="10" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MoodPillStyle}" MouseLeftButtonDown="MoodPill_Click" Tag="excited" Margin="0,5,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#FFD23F" Margin="0,0,4,0"/>
                                            <TextBlock Text="Excited" FontSize="10" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Key Metrics KPI Cards Row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Annual Total -->
                        <Border Grid.Column="0" Background="#18181B" BorderBrush="#26262B" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ANNUAL COMMITS" FontSize="9" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas"/>
                                <TextBlock x:Name="KpiTotalCommits" Text="0" FontSize="18" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                                <TextBlock Text="Past 52 weeks" FontSize="9.5" Foreground="#6E6E73"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Current Streak -->
                        <Border Grid.Column="1" Background="#18181B" BorderBrush="#26262B" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="CURRENT STREAK" FontSize="9" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas"/>
                                <TextBlock x:Name="KpiCurrentStreak" Text="0 Days" FontSize="18" FontWeight="ExtraBold" Foreground="#39D353" Margin="0,3,0,0"/>
                                <TextBlock Text="Consecutive active" FontSize="9.5" Foreground="#6E6E73"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Longest Streak -->
                        <Border Grid.Column="2" Background="#18181B" BorderBrush="#26262B" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="LONGEST STREAK" FontSize="9" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas"/>
                                <TextBlock x:Name="KpiLongestStreak" Text="0 Days" FontSize="18" FontWeight="ExtraBold" Foreground="#FFD23F" Margin="0,3,0,0"/>
                                <TextBlock Text="Personal best" FontSize="9.5" Foreground="#6E6E73"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Most Active Weekday -->
                        <Border Grid.Column="3" Background="#18181B" BorderBrush="#26262B" BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="PEAK WEEKDAY" FontSize="9" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas"/>
                                <TextBlock x:Name="KpiPeakDay" Text="Wednesday" FontSize="18" FontWeight="ExtraBold" Foreground="#89C4FF" Margin="0,3,0,0"/>
                                <TextBlock x:Name="KpiPeakDaySub" Text="Highest commit volume" FontSize="9.5" Foreground="#6E6E73"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 3. Analysis Charts (Side-by-Side) -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Chart 1: Weekday Activity Distribution -->
                        <Border Grid.Column="0" Background="#18181B" BorderBrush="#26262B" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="WEEKDAY ACTIVITY RHYTHM" FontSize="9.5" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas"/>
                                </StackPanel>
                                <!-- Weekday Bar Chart Canvas -->
                                <Grid x:Name="WeekdayBarsGrid" Height="100"/>
                            </StackPanel>
                        </Border>

                        <!-- Chart 2: Monthly Trends Volume -->
                        <Border Grid.Column="1" Background="#18181B" BorderBrush="#26262B" BorderThickness="1" CornerRadius="14" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="MONTHLY ACTIVITY VOLUME" FontSize="9.5" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas"/>
                                </StackPanel>
                                <!-- Monthly Bar Chart Canvas -->
                                <Grid x:Name="MonthlyBarsGrid" Height="100"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 4. Full 52-Week Heatmap Calendar -->
                    <Border Background="#18181B" BorderBrush="#26262B" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="52-WEEK ANNUAL HEATMAP CALENDAR" FontSize="9.5" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <Grid Height="125">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Day of week labels -->
                                <Grid Grid.Column="0" Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="1" Text="Mon" FontSize="8" Foreground="#6A7C70" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Text="Wed" FontSize="8" Foreground="#6A7C70" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="5" Text="Fri" FontSize="8" Foreground="#6A7C70" FontFamily="Consolas" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Month Labels + 52-Week Heatmap Grid -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid x:Name="MonthLabelsGrid" Grid.Row="0"/>
                                    <Grid x:Name="FullHeatmapGrid" Grid.Row="1"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 5. Top Public Repositories Commitment Drawer -->
                    <Border Background="#18181B" BorderBrush="#26262B" BorderThickness="1" CornerRadius="14" Padding="14,12">
                        <StackPanel>
                            <Grid Cursor="Hand" MouseLeftButtonDown="ToggleRepos_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TOP CONTRIBUTIONS IN REPOSITORIES" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TopReposSummary" Text="" FontSize="11" Foreground="#8E8E93" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="AvatarStack" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border x:Name="ChevronBorder" Width="24" Height="24" CornerRadius="12" Background="#26262B">
                                        <TextBlock x:Name="ChevronText" Text="⌵" FontSize="13" FontWeight="Bold" Foreground="#A1A1A6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Expandable Repositories List -->
                            <StackPanel x:Name="ReposListPanel" Margin="0,10,0,0" Visibility="Visible"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
