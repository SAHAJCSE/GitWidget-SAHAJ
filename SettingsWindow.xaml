<Window x:Class="GitHubDesktopWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget Settings"
        Icon="Assets/icon.ico"
        Width="460" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Apple Action Pill Button -->
        <Style x:Key="ApplePrimaryBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D1D1D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Dark Pill Button -->
        <Style x:Key="AppleSecondaryBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#242428"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#38383E" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#323238"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4C4C54"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Input Style -->
        <Style x:Key="AppleTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#38383E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="8,5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8E8E93"/>
                                <Setter TargetName="border" Property="Background" Value="#25252A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Apple Dark Glass Container -->
    <Border Background="#141416"
            BorderBrush="#2C2C30"
            BorderThickness="1"
            CornerRadius="16"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Window Header / Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                <!-- macOS Style Traffic Lights (Close button) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Width="12" Height="12" Click="CloseButton_Click" Cursor="Hand" ToolTip="Close (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="dot" CornerRadius="6" Background="#FF5F56" BorderBrush="#E0443E" BorderThickness="0.5"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="dot" Property="Background" Value="#E0443E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" BorderBrush="#DEA123" BorderThickness="0.5" Margin="7,0,0,0" Opacity="0.6"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#27C93F" BorderBrush="#1AAB29" BorderThickness="0.5" Margin="7,0,0,0" Opacity="0.6"/>
                </StackPanel>

                <!-- Window Title -->
                <TextBlock Text="Widget Settings"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Top Right Close X Button -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                        Width="24" Height="24" Click="CloseButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="12">
                                <TextBlock Text="✕" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2C2C30"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,4,18,6">
                <StackPanel>
                    <!-- Section 1: GitHub Account Card -->
                    <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="GITHUB ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="UsernameInput" Style="{StaticResource AppleTextBox}" Height="30" VerticalContentAlignment="Center" KeyDown="UsernameInput_KeyDown"/>
                                <Button Grid.Column="1" Content="Connect" Style="{StaticResource ApplePrimaryBtn}" Height="30" Margin="8,0,0,0" Click="SaveUser_Click"/>
                            </Grid>
                            <TextBlock x:Name="StatusMessage" FontSize="11" Foreground="#39D353" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Section: Detailed Activity & Top Repositories Card -->
                    <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="DETAILED ACTIVITY &amp; REPOSITORIES" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas" Margin="0,0,0,6"/>
                            <TextBlock Text="Open full 12-month calendar heatmap &amp; top repository commit drawer" FontSize="11" Foreground="#A1A1A6" Margin="0,0,0,10"/>
                            <Button x:Name="BtnDetail" Content="📊 View Activity Details &amp; Top Repos" Style="{StaticResource ApplePrimaryBtn}" Height="32" Click="BtnDetail_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Aesthetics & Themes Card -->
                    <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="COLOR THEME" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="ThemePillsPanel">
                                <!-- Clean Apple B&W Theme -->
                                <Border x:Name="ThemeMonoBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Theme_Click" Tag="mono">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="Apple B&amp;W" Foreground="#FFFFFF" FontSize="11" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                                <!-- Apple Light Mode Theme -->
                                <Border x:Name="ThemeLightBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Theme_Click" Tag="light">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#F5F5F7" Stroke="#888888" StrokeThickness="1" Margin="0,0,6,0"/>
                                        <TextBlock Text="Apple Light" Foreground="#FFFFFF" FontSize="11" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ThemeLiquidBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Theme_Click" Tag="liquid">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#39D353" Margin="0,0,6,0"/>
                                        <TextBlock Text="Liquid Glass" Foreground="#FFFFFF" FontSize="11" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ThemeClassicBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Theme_Click" Tag="classic">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#26A641" Margin="0,0,6,0"/>
                                        <TextBlock Text="GitHub Classic" Foreground="#FFFFFF" FontSize="11" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ThemeOLEDBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Theme_Click" Tag="oled">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#00FF66" Margin="0,0,6,0"/>
                                        <TextBlock Text="Midnight OLED" Foreground="#FFFFFF" FontSize="11" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ThemeAuroraBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Theme_Click" Tag="aurora">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#00FFC8" Margin="0,0,6,0"/>
                                        <TextBlock Text="Aurora Teal" Foreground="#FFFFFF" FontSize="11" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Cell Shapes Card -->
                    <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CONTRIBUTION SHAPE" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Border x:Name="ShapeCircleBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Shape_Click" Tag="circle">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="Circle" Foreground="#FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ShapeRoundedBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Shape_Click" Tag="rounded">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="Rounded" Foreground="#FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ShapeSquareBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Shape_Click" Tag="square">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="9" Height="9" Fill="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="Square" Foreground="#FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ShapeHexagonBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Shape_Click" Tag="hexagon">
                                    <StackPanel Orientation="Horizontal">
                                        <Polygon Width="9" Height="9" Stretch="Fill" Points="5,0 9.5,2.6 9.5,7.4 5,10 0.5,7.4 0.5,2.6" Fill="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="Hexagon" Foreground="#FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ShapeTriangleBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Shape_Click" Tag="triangle">
                                    <StackPanel Orientation="Horizontal">
                                        <Polygon Width="9" Height="9" Stretch="Fill" Points="5,0 10,10 0,10" Fill="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="Triangle" Foreground="#FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ShapeFlowerBtn" Margin="0,0,8,8" CornerRadius="8" Padding="10,6" Background="#242428" BorderBrush="#38383E" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Shape_Click" Tag="flower">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="9" Height="9" Stretch="Uniform" Data="M 5,0 C 6.5,0 7,2.5 5,4 C 7.5,2 10,3.5 10,5 C 10,6.5 7.5,8 5,6 C 7,7.5 6.5,10 5,10 C 3.5,10 3,7.5 5,6 C 2.5,8 0,6.5 0,5 C 0,3.5 2.5,2 5,4 C 3,2.5 3.5,0 5,0 Z" Fill="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="Flower" Foreground="#FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section 4: Display Range Card -->
                    <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="TIME RANGE" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <Border Background="#141416" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="8" Padding="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Range30DBtn" Grid.Column="0" CornerRadius="6" Padding="0,5" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Range30D_Click">
                                        <TextBlock Text="30 Days (Compact)" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Center" FontWeight="Medium"/>
                                    </Border>
                                    <Border x:Name="Range6MBtn" Grid.Column="1" CornerRadius="6" Padding="0,5" Background="#2C2C32" Cursor="Hand" MouseLeftButtonDown="Range6M_Click">
                                        <TextBlock Text="6 Months (Full)" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Center" FontWeight="Medium"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section 5: Desktop Behavior Switches -->
                    <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="DESKTOP BEHAVIOR" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas" Margin="0,0,0,8"/>

                            <!-- Pin to Desktop Toggle -->
                            <Grid Margin="0,4,0,8" Cursor="Hand" MouseLeftButtonDown="TogglePin_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Keep on Desktop" Foreground="#FFFFFF" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Text="Pins widget to wallpaper behind other applications" Foreground="#8E8E93" FontSize="10"/>
                                </StackPanel>
                                <Border x:Name="TogglePinSwitch" HorizontalAlignment="Right" Width="36" Height="20" CornerRadius="10" Background="#34C759" VerticalAlignment="Center">
                                    <Ellipse x:Name="TogglePinThumb" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Right" Margin="2,0,2,0"/>
                                </Border>
                            </Grid>
                            <Separator Background="#2A2A2E" Margin="0,2,0,8"/>

                            <!-- Lock Position Toggle -->
                            <Grid Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="ToggleLock_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Lock Position" Foreground="#FFFFFF" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Text="Disables dragging so widget stays firmly in place" Foreground="#8E8E93" FontSize="10"/>
                                </StackPanel>
                                <Border x:Name="ToggleLockSwitch" HorizontalAlignment="Right" Width="36" Height="20" CornerRadius="10" Background="#38383E" VerticalAlignment="Center">
                                    <Ellipse x:Name="ToggleLockThumb" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,2,0"/>
                                </Border>
                            </Grid>
                            <Separator Background="#2A2A2E" Margin="0,2,0,8"/>

                            <!-- Startup Toggle -->
                            <Grid Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="ToggleStartup_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Launch on Windows Startup" Foreground="#FFFFFF" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Text="Starts the widget automatically when you log in" Foreground="#8E8E93" FontSize="10"/>
                                </StackPanel>
                                <Border x:Name="ToggleStartupSwitch" HorizontalAlignment="Right" Width="36" Height="20" CornerRadius="10" Background="#34C759" VerticalAlignment="Center">
                                    <Ellipse x:Name="ToggleStartupThumb" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Right" Margin="2,0,2,0"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 6: Quick Actions -->
                    <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="↻ Refresh Activity" Style="{StaticResource AppleSecondaryBtn}" Margin="0,0,4,0" Click="RefreshAction_Click"/>
                                <Button Grid.Column="1" Content="↗ Open GitHub Profile" Style="{StaticResource AppleSecondaryBtn}" Margin="4,0,0,0" Click="OpenProfileAction_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions Bar -->
            <Border Grid.Row="2" Background="#18181A" BorderBrush="#26262A" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="18,0">
                <Grid>
                    <TextBlock Text="v2.0 • Native C# / WPF" FontSize="10" Foreground="#55555A" VerticalAlignment="Center"/>
                    <Button Content="Done" Style="{StaticResource ApplePrimaryBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="80" Click="CloseButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
