<Window x:Class="GitHubDesktopWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Desktop Widget"
        Icon="Assets/icon.ico"
        Width="495" Height="160"
        MinWidth="180" MinHeight="110"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.Resources>
        <!-- Flat Range Button Style (never turns white on click/focus) -->
        <Style x:Key="RangeBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="5,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3358D77B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5558D77B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Input Style -->
        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2218241C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#58D77B"/>
            <Setter Property="SelectionBrush" Value="#4458D77B"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu">
            <MenuItem Header="⚙ Widget Settings..." FontWeight="Bold" Click="MenuSettings_Click" />
            <Separator />
            <MenuItem Header="Time Range">
                <MenuItem x:Name="MenuRange30D" Header="30 Days (Compact)" Click="MenuRange30D_Click" />
                <MenuItem x:Name="MenuRange6M" Header="6 Months (Standard)" IsChecked="True" Click="MenuRange6M_Click" />
                <MenuItem x:Name="MenuRange1Y" Header="1 Year (Annual)" Click="MenuRange1Y_Click" />
            </MenuItem>
            <MenuItem Header="Themes">
                <MenuItem x:Name="MenuThemeMono" Header="Apple Monochrome (B&amp;W)" Click="MenuTheme_Click" Tag="mono" />
                <MenuItem x:Name="MenuThemeLight" Header="Apple Light Mode" Click="MenuTheme_Click" Tag="light" />
                <MenuItem x:Name="MenuThemeLiquid" Header="Liquid Glass (Transparent)" IsChecked="True" Click="MenuTheme_Click" Tag="liquid" />
                <MenuItem x:Name="MenuThemeClassic" Header="GitHub Classic Dark" Click="MenuTheme_Click" Tag="classic" />
                <MenuItem x:Name="MenuThemeOLED" Header="Midnight OLED" Click="MenuTheme_Click" Tag="oled" />
                <MenuItem x:Name="MenuThemeAurora" Header="Aurora Teal" Click="MenuTheme_Click" Tag="aurora" />
            </MenuItem>
            <MenuItem Header="Shapes">
                <MenuItem x:Name="MenuShapeCircle" Header="Circle" Click="MenuShape_Click" Tag="circle" />
                <MenuItem x:Name="MenuShapeHexagon" Header="Hexagon" Click="MenuShape_Click" Tag="hexagon" />
                <MenuItem x:Name="MenuShapeTriangle" Header="Triangle" Click="MenuShape_Click" Tag="triangle" />
                <MenuItem x:Name="MenuShapeRounded" Header="Rounded Square" Click="MenuShape_Click" Tag="rounded" />
                <MenuItem x:Name="MenuShapeSquare" Header="Square" Click="MenuShape_Click" Tag="square" />
                <MenuItem x:Name="MenuShapeFlower" Header="Flower" Click="MenuShape_Click" Tag="flower" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="MenuLock" Header="Disable Moving (Lock)" Click="MenuLock_Click" />
            <MenuItem x:Name="MenuTopmost" Header="Keep on Desktop (Behind Apps)" IsChecked="True" Click="MenuTopmost_Click" />
            <MenuItem x:Name="MenuStartup" Header="Start with Windows" IsChecked="True" Click="MenuStartup_Click" />
            <MenuItem x:Name="MenuSound" Header="Sound Effects (Enabled)" IsChecked="True" Click="MenuSound_Click" />
            <MenuItem Header="Refresh Activity" Click="MenuRefresh_Click" />
            <MenuItem Header="Open GitHub Profile" Click="MenuProfile_Click" />
            <Separator />
            <MenuItem Header="Hide to Tray" Click="MenuHide_Click" />
            <MenuItem Header="Quit Widget" Click="MenuQuit_Click" Foreground="#FF8888" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Slim Apple-like Design: Smooth rounded corners, clean transparent glass, NO boxy shadow -->
    <Border x:Name="MainBorder"
            Background="#180B130E"
            BorderBrush="#2558D77B"
            BorderThickness="1"
            CornerRadius="18"
            Padding="16,11,16,11">

        <Grid>
            <!-- Setup Username Overlay (shown if no username configured) -->
            <Grid x:Name="SetupPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Connect your GitHub" Foreground="#58D77B" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="@" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="UsernameInput" Style="{StaticResource FlatTextBoxStyle}" Width="180" Height="26" VerticalContentAlignment="Center" Padding="4,0" KeyDown="UsernameInput_KeyDown"/>
                        <Button Content="Connect" Style="{StaticResource RangeBtnStyle}" Width="65" Height="26" Margin="6,0,0,0" Background="#2EA043" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="ConnectButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SetupError" Foreground="#FF8585" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Responsive Widget Content View -->
            <Grid x:Name="ContentPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: Stat Headline + Eye Pointer + 30D/6M Toggle -->
                <Grid Grid.Row="0" Margin="2,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- GitHub Octocat Logo SVG -->
                        <Path x:Name="GitHubLogo"
                              Width="15" Height="15"
                              Margin="0,0,7,4"
                              VerticalAlignment="Bottom"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>

                        <Border ClipToBounds="True" Height="26" VerticalAlignment="Bottom">
                            <TextBlock x:Name="StatNumberText" Text="--" FontSize="19" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="StatNumberTranslate" Y="0"/>
                                        <ScaleTransform x:Name="StatNumberScale" ScaleX="1" ScaleY="1"/>
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="StatLabelText" Text="6M contributions" FontSize="10" Foreground="#9CB1A2" Margin="7,0,0,3" VerticalAlignment="Bottom" FontFamily="Consolas"/>

                        <!-- Expressive Companion Bot Character (34x30) with 6 Emotions -->
                        <Grid x:Name="BotContainer" Width="34" Height="30" VerticalAlignment="Bottom" Margin="8,0,0,2" Cursor="Hand" ToolTip="Click to interact with Bot!">
                            <!-- Optional Electric Lightning Emblem for Excited mood -->
                            <Path x:Name="BotLightningBadge"
                                  Data="M 17,2 L 23,12 L 17,14 L 21,24 L 11,14 L 17,12 Z"
                                  Fill="#FFD23F"
                                  Stretch="Uniform"
                                  Width="32" Height="30"
                                  Visibility="Collapsed"
                                  Opacity="0.85"/>

                            <!-- Character Body Badge (Round / Squircle) -->
                            <Rectangle x:Name="BotBody"
                                       Width="30" Height="27"
                                       RadiusX="13" RadiusY="13"
                                       Stroke="#40FFFFFF"
                                       StrokeThickness="0.8">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.4,0.3" RadiusX="0.8" RadiusY="0.8">
                                        <GradientStop x:Name="BotGradStop1" Color="#99E870" Offset="0"/>
                                        <GradientStop x:Name="BotGradStop2" Color="#58B838" Offset="0.6"/>
                                        <GradientStop x:Name="BotGradStop3" Color="#2E6A1C" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Top Specular Gloss Reflection Highlight -->
                            <Ellipse Width="15" Height="6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" Opacity="0.75">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.3" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#CCFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Expressive Eyes Container (Blinking support) -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="BotEyesScale" ScaleY="1.0"/>
                                </Grid.RenderTransform>
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="BotLeftEyePath"
                                          Data="M 0,4 Q 3.5,0 7,4"
                                          Stroke="#1E4010"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Margin="0,0,5,0"/>
                                    <Path x:Name="BotRightEyePath"
                                          Data="M 0,4 Q 3.5,0 7,4"
                                          Stroke="#1E4010"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dynamic Mouth -->
                            <Path x:Name="BotMouthPath"
                                  Data="M 0,0 Q 4.5,5 9,0"
                                  Stroke="#1E4010"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Margin="0,18,0,0"/>

                            <!-- Sleepy Yawn Mouth (used specifically in Sleepy mood) -->
                            <Ellipse x:Name="BotSleepyMouth"
                                     Width="5" Height="6"
                                     Fill="#102848"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,17,0,0"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>

                    <!-- Range Selector (30D / 6M / 1Y) + Settings Gear -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="RangeSwitchBorder" Background="#15FFFFFF" BorderBrush="#2058D77B" BorderThickness="1" CornerRadius="5" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="Btn30D" Content="30D" Style="{StaticResource RangeBtnStyle}" Height="19" FontSize="9" FontWeight="Bold" Background="Transparent" Foreground="#888888" BorderThickness="0" Click="Btn30D_Click"/>
                                <Button x:Name="Btn6M" Content="6M" Style="{StaticResource RangeBtnStyle}" Height="19" FontSize="9" FontWeight="Bold" Background="#3358D77B" Foreground="#58D77B" BorderThickness="0" Click="Btn6M_Click"/>
                                <Button x:Name="Btn1Y" Content="1Y" Style="{StaticResource RangeBtnStyle}" Height="19" FontSize="9" FontWeight="Bold" Background="Transparent" Foreground="#888888" BorderThickness="0" Click="Btn1Y_Click"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnSettingsHeader" Width="21" Height="21" Margin="5,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Open Settings"
                                Click="BtnSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#14FFFFFF" CornerRadius="11">
                                        <Path x:Name="gearIcon" Width="10" Height="10" Stretch="Uniform" Fill="#889988"
                                              Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3358D77B"/>
                                            <Setter TargetName="gearIcon" Property="Fill" Value="#58D77B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Fully Responsive Heatmap Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Day of Week Labels -->
                    <Grid Grid.Column="0" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" Text="Mon" FontSize="7" Foreground="#6A7C70" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Text="Wed" FontSize="7" Foreground="#6A7C70" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Text="Fri" FontSize="7" Foreground="#6A7C70" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Months + Responsive Circular Heatmap -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Synchronized Month Labels Grid -->
                        <Grid x:Name="MonthLabelsGrid" Grid.Row="0"/>

                        <!-- Responsive Circular Heatmap Grid -->
                        <Grid x:Name="HeatmapGrid" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Floating Apple Settings Quick Icon / Pill (Appears on Right Click) -->
            <Border x:Name="QuickSettingsPill"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    Opacity="0"
                    Background="#F018181A"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="10,6"
                    Cursor="Hand"
                    RenderTransformOrigin="0.5,0.5"
                    MouseLeftButtonDown="QuickSettingsPill_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="QuickSettingsScale" ScaleX="0.6" ScaleY="0.6"/>
                        <TranslateTransform x:Name="QuickSettingsTranslate"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" Margin="0,0,6,0"
                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                    <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
