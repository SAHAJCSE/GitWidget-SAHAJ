<Window x:Class="GitWidgetSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitWidget - SAHAJ Setup"
        Width="540" Height="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Apple Glass Action Button Style -->
        <Style x:Key="AppleButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#39D353" CornerRadius="9" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4DE868"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" Color="#39D353" Opacity="0.45" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2EA043"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2E"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Close Button -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Width="22" Height="22">
                            <Path Data="M 6,6 L 14,14 M 14,6 L 6,14" Stroke="#8E8E93" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style x:Key="AppleCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D1D1D6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Main Container Card -->
    <Border Background="#141416"
            BorderBrush="#2C2C30"
            BorderThickness="1"
            CornerRadius="18"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Titlebar -->
                <RowDefinition Height="Auto"/> <!-- Sahaj Animated Hero -->
                <RowDefinition Height="*"/>    <!-- Status & Animation Terminal -->
                <RowDefinition Height="Auto"/> <!-- Progress Bar -->
                <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Minimal Titlebar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- GitHub Mark -->
                    <Path Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#9E9EA4" Stretch="Uniform"
                          Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    <TextBlock Text="GITWIDGET INSTALLER &amp; LAUNCHER" FontSize="9.5" FontWeight="Bold" Foreground="#8E8E93" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseBtn}" HorizontalAlignment="Right" Click="CloseBtn_Click"/>
            </Grid>

            <!-- 2. Sahaj Hero Typography with Animated Glow -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock x:Name="SahajTitleText" Text="GitWidget • SAHAJ" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                    <Border Background="#1C2B20" BorderBrush="#39D353" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows 11 Native" FontSize="9" FontWeight="Bold" Foreground="#39D353"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SahajSubtitleText" Text="Ultra-compact GitHub desktop activity monitor • ~290 KB native footprint" FontSize="11" Foreground="#8E8E93"/>
            </StackPanel>

            <!-- 3. Animated Sahaj Status & Terminal Interface -->
            <Border Grid.Row="2" Background="#1A1A1D" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Typewriter dynamic animated headline -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#39D353" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#39D353" Opacity="0.8" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="TypewriterStatus" Text="Initializing GitWidget-SAHAJ environment..." FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                        <TextBlock x:Name="BlinkingCursor" Text="▌" FontSize="11.5" Foreground="#39D353" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- Dynamic Detailed Step Log -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LogPanel">
                            <!-- Populated dynamically with animated step transitions -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 4. Modern Glowing Progress Bar -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Border Height="5" Background="#26262B" CornerRadius="2.5">
                    <Grid HorizontalAlignment="Left">
                        <Border x:Name="ProgressBarFill" Height="5" CornerRadius="2.5" Width="0" Background="#39D353">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#39D353" Opacity="0.5" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. Bottom Controls & Action Button -->
            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkShortcut" Content="Create Desktop Shortcut" IsChecked="True" Style="{StaticResource AppleCheckBox}" Margin="0,0,14,0"/>
                    <CheckBox x:Name="ChkAutoStart" Content="Start with Windows" IsChecked="True" Style="{StaticResource AppleCheckBox}"/>
                </StackPanel>

                <Button x:Name="ActionBtn" Content="Start &amp; Launch" Style="{StaticResource AppleButton}" HorizontalAlignment="Right" Click="ActionBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
